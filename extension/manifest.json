{
  "manifest_version": 3,
  "name": "JABB Networks · SENTINEL Voice & Video",
  "version": "1.0.0",
  "description": "Hands-free SENTINEL voice + live video connection to your JABB Networks crew and free local AI models (Ollama/Nemotron).",
  "permissions": ["sidePanel", "storage", "tabs"],
  "optional_permissions": ["tabCapture"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Open SENTINEL (voice & video)",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
