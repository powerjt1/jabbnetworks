# ---------------------------------------------------------------------------
# Every integration below is OPTIONAL. With none of them set, the app runs on
# seed data and every screen is navigable — useful for demos and for working on
# the UI. Fill them in to switch each subsystem over to live.
#
# You create these accounts yourself: they require your identity documents, a
# tax ID and a bank account, so nobody can provision them on your behalf.
# ---------------------------------------------------------------------------

# Supabase — database, auth, storage. https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Stripe — escrow, funding and payouts. https://dashboard.stripe.com/register
# Use test keys (sk_test_…) until you have run a full milestone end to end.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe`,
# or the webhook endpoint you create in the dashboard.
STRIPE_WEBHOOK_SECRET=

# Plaid — instant bank verification for ACH. https://dashboard.plaid.com/signup
PLAID_CLIENT_ID=
PLAID_SECRET=
NEXT_PUBLIC_PLAID_ENV=sandbox

# PayPal — alternative payout rail. https://developer.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Daily.co — video meeting rooms. https://dashboard.daily.co/signup
DAILY_API_KEY=
NEXT_PUBLIC_DAILY_DOMAIN=

# QuickBooks Online — accounting sync. https://developer.intuit.com
# Intuit provides a sandbox company, so you can post real documents without
# touching live books.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_ENV=sandbox
QBO_REDIRECT_URI=http://localhost:3000/api/quickbooks/callback
# Populated after the first successful OAuth round trip. Intuit rotates the
# refresh token on every use — whatever stores it must overwrite, not insert.
QBO_REFRESH_TOKEN=
QBO_REALM_ID=
# Optional: the QuickBooks account ids to post against.
QBO_CONTRACTOR_EXPENSE_ACCOUNT=
QBO_FEE_INCOME_ACCOUNT=
